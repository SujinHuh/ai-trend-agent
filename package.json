{
  "name": "ai-trend-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start:cron:serve": "node dist/src/cli.js cron:serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:serve": "node scripts/serve-docs.mjs",
    "db:init": "node --import tsx src/cli.ts db:init",
    "sample:seed": "node --import tsx src/cli.ts sample:seed",
    "digest:get": "node --import tsx src/cli.ts digest:get",
    "sources:validate": "node --import tsx src/cli.ts sources:validate",
    "ingest:run": "node --import tsx src/cli.ts ingest:run",
    "digest:candidates": "node --import tsx src/cli.ts digest:candidates",
    "wiki:query": "node --import tsx src/cli.ts wiki:query",
    "wiki:index": "node --import tsx src/cli.ts wiki:index",
    "slack:preview": "node --import tsx src/cli.ts slack:preview",
    "slack:send": "node --import tsx src/cli.ts slack:send",
    "cron:run": "node --import tsx src/cli.ts cron:run",
    "cron:serve": "node --import tsx src/cli.ts cron:serve"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
